# Local-dev template — copy to `.env` and fill in your own values.
#
# Vite env file layout in this project:
#   .env             ← your local dev values (gitignored — start from this file)
#   .env.local       ← optional dev override (gitignored)
#   .env.production  ← committed; loaded automatically by `vite build`
#   .env.example     ← this file (template, no real values)
#
# Only VITE_* prefixed vars are exposed to the bundle. Everything in the
# bundle is PUBLIC — never put secret keys here. Secrets live in the
# backend's .env on EC2.

VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Google Maps JS API key — used by the venue picker on event create/edit.
# Enable the "Maps JavaScript API" and "Places API" on the same project.
# Leaving this unset disables autocomplete; the venue field becomes a plain
# text input.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
