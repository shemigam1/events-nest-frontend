# Production build values — loaded automatically by `vite build`
# (which runs in mode=production by default).
#
# IMPORTANT: anything in a frontend bundle is public. The values below ship
# to every visitor's browser. Only put things here that are safe to publish:
#   - Identifiers (client IDs, project tokens, publishable keys)
#   - Public API keys restricted by HTTP referrer in the provider's console
# NEVER put secret keys here (Stripe sk_*, Brevo, OpenAI, JWT signing, AWS
# secret access keys). Those live in the BACKEND .env on EC2.

# Relative path — nginx in the frontend container proxies /api/* to the
# backend over the Docker network. Same default the Dockerfile uses.
VITE_API_BASE_URL=/api/v1

# Google Maps JS API key — venue picker on event create/edit.
# MUST be restricted to your production HTTP referrer in Google Cloud
# Console (APIs & Services → Credentials → edit key → Application
# restrictions → HTTP referrers). Without that restriction anyone can
# scrape this from the bundle and burn your quota.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyBDE16BJe7hLeNdMIYKiaSQCXz_PCWTYmA