# Production build values — loaded automatically by `vite build`
# (which runs in mode=production by default).
#
# Keys that vary by environment / shouldn't be in git history come from
# GitHub Actions secrets via --build-arg in the deploy workflow:
#   VITE_GOOGLE_MAPS_API_KEY  ← set in repo Settings → Secrets → Actions
#
# Only put values in THIS file that are happy to be in git forever:
#   - URLs / paths
#   - Non-sensitive feature flags

# Relative path — nginx in the frontend container proxies /api/* to the
# backend over the Docker network. Same default the Dockerfile uses.
VITE_API_BASE_URL=/api/v1