# ── Stage 1: build ────────────────────────────────────────────────────────────
# Pin to linux/amd64 so local Apple-Silicon builds still produce an image that
# runs on the EC2 host (x86_64). GHA ubuntu-latest is already amd64 so this is
# a no-op there.
FROM --platform=linux/amd64 node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# VITE_API_BASE_URL is relative so the built JS works on any host.
# The Nginx layer proxies /api/* → backend:8080 at runtime.
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Public Vite vars supplied by CI (GitHub Actions secrets → --build-arg).
# These end up baked into the bundle and are publicly visible at runtime —
# only ship keys that are safe to expose AND restricted by HTTP referrer
# in the provider's console (Google Cloud Console for Maps).
ARG VITE_GOOGLE_MAPS_API_KEY=""
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY

RUN npm run build

# ── Stage 2: serve ─────────────────────────────────────────────────────────────
FROM --platform=linux/amd64 nginx:1.27-alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -qO- http://127.0.0.1/health || exit 1
